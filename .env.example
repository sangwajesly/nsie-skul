# Supabase Public Configuration (accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Only Secret (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application & Technical SEO Settings
NEXT_PUBLIC_APP_NAME="Nsei Sukul"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical Site URL (Single source of truth for canonical tags, sitemaps, and robots)
# Current production domain: https://nsei-sukul.klarifypath.com
NEXT_PUBLIC_SITE_URL=https://nsei-sukul.klarifypath.com

# Search Engine Verification Tokens (Optional)
# Google Search Console (HTML Tag verification token content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools (msvalidate.01 meta content)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
