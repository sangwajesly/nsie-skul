# Enable School Hub mode
NEXT_PUBLIC_HUB_MODE=true
HUB_MODE=true

# Hub Node Authentication Key (Generated from School Settings -> School Hub)
HUB_NODE_KEY=hub_gbhs_your_generated_node_key_here

# Central Cloud Synchronization Endpoint
CLOUD_SYNC_URL=https://nsei-sukul.klarifypath.com/api/v1/hub/sync

# Local Database Credentials
HUB_DB_USER=nsei_admin
HUB_DB_PASSWORD=nsei_secure_pass_2026
HUB_DB_NAME=nsei_sukul_hub

# Local Server Port
PORT=3000
